# Pahredaar-IoT Environment Configuration Template
ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Security & CORS (Set explicit frontend origins in production)
CORS_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173","http://127.0.0.1:5173","http://localhost:5173"]
SECRET_KEY=pahredaar-insecure-dev-secret-key-change-in-prod-32b
API_KEY=pahredaar-sensor-secret-key-change-in-production
ENABLE_INGEST_AUTH=false
RATE_LIMIT_INGEST_PER_SEC=500

# Storage & Persistence
DB_PATH=backend/app/iot_ids.db

# ML & Detection Engine
MODEL_DIR=backend/app/models
GRACE_PERIOD_FLOWS=15

# Phase 3: Open-Set Detection Settings
ENABLE_OPEN_SET=true
OPEN_SET_MODEL_DIR=backend/app/models/open_set_v1
OPEN_SET_CONFIDENCE_THRESHOLD=0.70
OPEN_SET_NOVELTY_THRESHOLD=1.25
ALERT_SUPPRESSION_WINDOW_SEC=5.0

# Phase 4 & 5: Advanced Hybrid AI & Risk Settings
ENABLE_TREESHAP=true
ENABLE_TEMPORAL=true
ENABLE_GRAPH=true
ENABLE_HIERARCHICAL_RISK=true
TEMPORAL_MODEL_DIR=backend/app/models/temporal_v1
GRAPH_MODEL_DIR=backend/app/models/graph_v1

RISK_WEIGHT_FLOW=0.40
RISK_WEIGHT_NOVELTY=0.30
RISK_WEIGHT_TEMPORAL=0.20
RISK_WEIGHT_GRAPH=0.10
RISK_DECAY_HALF_LIFE_SEC=120.0
RISK_CORROBORATION_BONUS=0.50

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
